if [[ "$CMD" == *"list-timers"* ]]; then
    NOW=$(date +%s)
    D_NEXT1=$(date -d "@$((NOW + 14))" "+%a %Y-%m-%d %H:%M:%S %Z")
    D_LAST1=$(date -d "@$((NOW - 16))" "+%a %Y-%m-%d %H:%M:%S %Z")
    D_NEXT2=$(date -d "@$((NOW + 1800))" "+%a %Y-%m-%d %H:%M:%S %Z")
    D_LAST2=$(date -d "@$((NOW - 14400))" "+%a %Y-%m-%d %H:%M:%S %Z")
    D_NEXT3=$(date -d "@$((NOW + 7200))" "+%a %Y-%m-%d %H:%M:%S %Z")
    D_LAST3=$(date -d "@$((NOW - 28800))" "+%a %Y-%m-%d %H:%M:%S %Z")
    D_NEXT4=$(date -d "@$((NOW + 21600))" "+%a %Y-%m-%d %H:%M:%S %Z")
    D_LAST4=$(date -d "@$((NOW - 64800))" "+%a %Y-%m-%d %H:%M:%S %Z")
    D_NEXT5=$(date -d "@$((NOW + 43200))" "+%a %Y-%m-%d %H:%M:%S %Z")
    D_LAST5=$(date -d "@$((NOW - 43200))" "+%a %Y-%m-%d %H:%M:%S %Z")

    cat << EOF
