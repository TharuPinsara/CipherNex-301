ACTIVE = The high-level unit activation state, i.e. generalization of SUB.
SUB    = The low-level unit activation state, values depend on unit type.
13 loaded units listed.
EOF
    exit 0

# --- 3. STATUS CHECKS (VULNERABLE TARGET) ---
elif [[ "$CMD" == *"status orbital-sync.service"* ]] || [[ "$CMD" == *"status orbital-sync"* ]]; then
    cat << EOF
● orbital-sync.service - Operational telemetry synchronization daemon
     Loaded: loaded (/etc/systemd/system/orbital-sync.service; enabled; vendor preset: enabled)
     Active: active (running) since $(date -d "-15 minutes" "+%a %Y-%m-%d %H:%M:%S %Z")
