$D_NEXT1 14s left      $D_LAST1 16s ago      orbital-sync.timer           orbital-sync.service
$D_NEXT2 30min left    $D_LAST2 4h ago       motd-news.timer              motd-news.service
$D_NEXT3 2h left       $D_LAST3 8h ago       apt-daily.timer              apt-daily.service
$D_NEXT4 6h left       $D_LAST4 18h ago      logrotate.timer              logrotate.service
$D_NEXT5 12h left      $D_LAST5 12h ago      systemd-tmpfiles-clean.timer systemd-tmpfiles-clean.service
