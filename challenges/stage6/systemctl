     CGroup: /system.slice/orbital-sync.service
             ├─842 /bin/bash /opt/orbital-sync/sync_job.sh
             └─849 sleep 30
EOF
    exit 0

elif [[ "$CMD" == *"status orbital-sync.timer"* ]]; then
    cat << EOF
● orbital-sync.timer - Periodic trigger for orbital telemetry synchronization
     Loaded: loaded (/etc/systemd/system/orbital-sync.timer; enabled; vendor preset: enabled)
     Active: active (waiting) since $(date -d "-1 hour" "+%a %Y-%m-%d %H:%M:%S %Z")
    Trigger: orbital-sync.service
   Triggers: ● orbital-sync.service
EOF
    exit 0

